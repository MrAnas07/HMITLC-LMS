{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js",
      "mitigate": {
        "action": "bypass"
      }
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
